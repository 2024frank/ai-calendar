# Local development: create a separate MySQL database before migrating.
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_USERNAME=
DATABASE_PASSWORD=
DATABASE_NAME=ai_calendar_dev
DATABASE_SSL=false
DB_POOL_SIZE=3

# Set independently generated values of at least 32 characters.
AUTH_JWT_SECRET=
AGENT_INGEST_SECRET=
CRON_SECRET=
# Optional; defaults to CRON_SECRET when omitted.
# One or more secrets separated by commas; the first is used for self-dispatch.
WORKER_SECRET=
APP_URL=http://localhost:3000
PERPLEXITY_API_KEY=

# Optional email delivery. Without either provider, development logs the link.
HOSTINGER_EMAIL=
HOSTINGER_EMAIL_PASSWORD=
RESEND_API_KEY=
EMAIL_FROM=
PUBLISH_EMAIL=

# Required for applicable managed databases. Production must use verified TLS
# (DATABASE_SSL=true) and an HTTPS APP_URL, never the local settings above.
DATABASE_CA_CERT=
